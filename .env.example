# 复制为项目根目录 .env 后按需修改（勿提交真实密钥）

# LLM 路由（deepseek | openai；业务不绑定具体供应商）
LLM_PROVIDER=deepseek
LLM_DEFAULT_MODE=chat
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=0.8
# Optional JSON object. Unknown model pricing intentionally yields no estimate.
LLM_PRICE_TABLE={}
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_SECONDS=30

# DeepSeek（LLM_PROVIDER=deepseek 时使用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 默认模式：chat（快）| reasoner（深度推理，有 reasoning_content）
DEEPSEEK_DEFAULT_MODE=chat
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
# 兼容旧字段（未设 CHAT_MODEL 时回退）
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_RETRY_BASE_DELAY=0.8
DEEPSEEK_REASONER_MIN_TOKENS=1024

# OpenAI（LLM_PROVIDER=openai 时使用）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_REASONER_MODEL=o4-mini
OPENAI_TIMEOUT=60
OPENAI_REASONER_MIN_TOKENS=1024

# RAG cache/index versioning (bump index version after knowledge rebuild)
RAG_INDEX_VERSION=v2
RAG_RETRIEVAL_VERSION=hybrid-v2

# Master：规划用 reasoner，逐步决策默认 chat（省成本）
MASTER_MAX_CONCURRENT=8
MASTER_FAST_PATH_ENABLED=true
MASTER_MAX_PLAN_STEPS=5
MASTER_RECOVERY_MAX_STEPS=2
MASTER_MAX_LLM_CALLS=3
MASTER_PLAN_MODE=reasoner
MASTER_REACT_MODE=chat
MASTER_PLAN_MAX_TOKENS=2048
MASTER_REACT_MAX_TOKENS=800
MASTER_REASONING_STORE_CHARS=400

# Postgres
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PWD=
PG_DB=ecom_matrix
PG_READ_USER=
PG_READ_PWD=
PG_WRITE_USER=
PG_WRITE_PWD=
DB_READ_STATEMENT_TIMEOUT_MS=5000
DB_WRITE_STATEMENT_TIMEOUT_MS=10000
DB_READ_MAX_ROWS=500

# 模拟店铺（seed 商品归属本店，不是市场公共数据）
DEMO_STORE_ID=demo_store
DEMO_STORE_NAME=我的模拟独立站
# 外部站模拟货盘条数：python -m ecom_agent_matrix.scripts.seed_demo_data --external-target 1000

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_SOCKET_TIMEOUT_SECONDS=3

# CRM 短记忆滑动窗口
SHORT_MEMORY_TTL=3600
SHORT_MEMORY_MAX_MESSAGES=20
EMBEDDING_TIMEOUT_SECONDS=30
RERANK_TIMEOUT_SECONDS=15

# HTTP resource-server authentication
APP_ENV=development
AUTH_MODE=api_key
ALLOW_INSECURE_LOCAL=false
API_KEY=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=
JWT_AUDIENCE=
DEV_TENANT_ID=demo_tenant
DEV_STORE_ID=demo_store
DEV_USER_ID=demo_user
DEV_ROLES=admin
DEV_SCOPES=
APPROVAL_TTL_SECONDS=600
API_REQUEST_TIMEOUT=90
METRICS_AUTH_REQUIRED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
LLM_REQUIRED_FOR_READINESS=false
SHUTDOWN_TIMEOUT_SECONDS=10
DEBUG_TRACE_ENABLED=false

# 最终结果 LLM 整理（true=生成可读 summary）
OUTPUT_POLISH_ENABLED=true
OUTPUT_POLISH_MAX_TOKENS=400

# 子 Agent 解读层（RAG/报表/竞品/库存/数据校验）
AGENT_LLM_EXPLAIN_ENABLED=true
AGENT_LLM_EXPLAIN_MAX_TOKENS=450

# Redis（生产建议设置密码）
REDIS_PASSWORD=

# 竞品价格查询：demo | http（http 需配置自有 COMPETITOR_PRICE_API_URL）
# 旧名 COMPETITOR_SPIDER_MODE 已废弃，请使用 COMPETITOR_PRICE_MODE
COMPETITOR_PRICE_MODE=demo
COMPETITOR_PRICE_API_URL=
COMPETITOR_PRICE_API_KEY=
COMPETITOR_PRICE_API_TIMEOUT=10
COMPETITOR_HTTP_FALLBACK_DEMO=true

# 社媒限流：process | redis
SOCIAL_RATE_LIMIT_MODE=process

# 淘宝开放平台 TOP（可选；查订单等需 session）
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_SESSION_KEY=
TAOBAO_API_URL=https://eco.taobao.com/router/rest
